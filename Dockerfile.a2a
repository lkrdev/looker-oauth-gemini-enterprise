# Use Python 3.12 or above as required by pyproject.toml
FROM python:3.12-slim

# Install uv via binary copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Set the working directory
WORKDIR /app

# Enable bytecode compilation for faster startup
ENV UV_COMPILE_BYTECODE=1

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies into the system environment
RUN uv pip install --system -r pyproject.toml

# Copy the rest of the application code
COPY . .

# Cloud Run defaults to PORT 8080
ENV PORT=8080
EXPOSE $PORT

# Set pythonpath to allow absolute imports from 'ca_api_agent'
ENV PYTHONPATH=/app

# Run the A2A app using uvicorn
CMD exec uvicorn a2a_main:a2a_app --host 0.0.0.0 --port $PORT
